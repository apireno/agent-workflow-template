{
  "_comment": "Template for the CTO repo's .claude/settings.json. Copy or merge into .claude/settings.json after Sprint A. Do NOT include the _comment fields when applying.",
  "_comment_defaultMode": "acceptEdits is the recommended posture for CTO orchestration work \u2014 auto-approve Edit/Write, Bash still prompts. CEO can override per-session with Shift+Tab.",
  "defaultMode": "acceptEdits",
  "_comment_harnessTools": "Monitor / TaskStop / PushNotification are HARNESS-NATIVE tools, not Bash — Bash(*) does not cover them, so without these entries the orchestrator prompts on every watcher arm. Monitor is also the sanctioned way to run a watcher past the background-Bash cap; see scripts/cto/watch-file-or-prompt.sh --stream for what it should wrap.",
  "_comment_opsScripts": "This posture grants blanket Bash(*), so scripts/cto/*.sh need no per-script allow entries. If you tighten Bash(*), add one entry per ops script in the SAME commit that adds the script: \"Bash(bash $CLAUDE_PROJECT_DIR/scripts/cto/<script>.sh:*)\". Use $CLAUDE_PROJECT_DIR — it is the variable Claude Code expands in Bash permission rules; an invented name expands to nothing and matches nothing. See scripts/cto/README.md.",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__codegram",
      "mcp__codegram__ask",
      "mcp__codegram__ask_fleet",
      "mcp__codegram__search_docs",
      "mcp__codegram__traverse",
      "mcp__codegram__provenance",
      "mcp__domshell",
      "mcp__domshell__domshell_execute",
      "Monitor",
      "TaskStop",
      "PushNotification"
    ]
  },
  "_comment_skillBudget": "Default skill listing budget is 1% of context. With ~15 skills planned, raise to 2% to keep descriptions intact.",
  "skillListingBudgetFraction": 0.02,
  "hooks": {
    "_comment_SessionStart": "Run preflight on every session start. Output appears in Claude's context as additionalContext \u2014 warnings/errors surface immediately.",
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agentic/preflight.sh"
          }
        ]
      }
    ],
    "_comment_Stop_inbox": "Drain ~/.cto/inbox/ at the end of every turn. Sprint B work \u2014 wire this in once /escalate-drain skill exists.",
    "_Stop_placeholder": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agentic/inbox-peek.sh"
          }
        ]
      }
    ]
  }
}
