{
  "_comment": "Template for the CTO repo's .claude/settings.json. Copy or merge into .claude/settings.json after Sprint A. Do NOT include the _comment fields when applying.",

  "_comment_defaultMode": "acceptEdits is the recommended posture for CTO orchestration work — auto-approve Edit/Write, Bash still prompts. CEO can override per-session with Shift+Tab.",
  "defaultMode": "acceptEdits",

  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },

  "_comment_skillBudget": "Default skill listing budget is 1% of context. With ~15 skills planned, raise to 2% to keep descriptions intact.",
  "skillListingBudgetFraction": 0.02,

  "hooks": {
    "_comment_SessionStart": "Run preflight on every session start. Output appears in Claude's context as additionalContext — warnings/errors surface immediately.",
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/agentic/preflight.sh"
          }
        ]
      }
    ],

    "_comment_Stop_inbox": "Drain ~/.cto/inbox/ at the end of every turn. Sprint B work — wire this in once /escalate-drain skill exists.",
    "_Stop_placeholder": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/agentic/inbox-peek.sh"
          }
        ]
      }
    ]
  }
}
