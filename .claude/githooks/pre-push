#!/usr/bin/env bash
# pre-push — no direct pushes to the base branch (Free-plan mitigation; ADR-003).
#
# On GitHub Free a private repo has no branch protection, so a plain `git push origin HEAD:main`
# skips every landing check: contains-base, CI, the sprint tag, the reap. This hook refuses a push
# that updates the remote's base branch (the one origin/HEAD names) unless it comes from
# scripts/agentic/land-lane.sh, which sets LAND_LANE=1. Other branches push freely.
#
# It is CLIENT-SIDE and says so: a machine without the hook, or `git push --no-verify`, still gets
# through. The daily hygiene report flags base commits that carry no sprint/ tag.
# Deliberate exception, logged:  ALLOW_BASE_PUSH="<why>" git push …
set -uo pipefail
REMOTE="${1:-origin}"
LEGACY="$(git rev-parse --absolute-git-dir 2>/dev/null)/hooks/pre-push"
if [ -x "$LEGACY" ] && [ "$(cd "$(dirname "$LEGACY")" && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
    INPUT="$(cat)"; printf '%s\n' "$INPUT" | "$LEGACY" "$@" || exit $?
else
    INPUT="$(cat)"
fi
[ "${LAND_LANE:-0}" = "1" ] && exit 0
BASE="$(git symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null)"; BASE="${BASE#"$REMOTE"/}"
[ -n "$BASE" ] || exit 0          # remote HEAD unknown: nothing to protect yet (land-lane refuses until it is set)
# A NEW remote branch named like a base branch (master in a main repo, or vice versa) is a push
# from the wrong checkout or a chained `cd` — fleet report 2026-11-04: a stray `master` pushed to
# a `main` repo. Refused unless deliberate: ALLOW_NEW_BASE="<why>".
ZERO=0000000000000000000000000000000000000000
while read -r _lref _lsha rref _rsha; do
    case "$rref" in refs/heads/main|refs/heads/master|refs/heads/trunk|refs/heads/develop|refs/heads/development) ;; *) continue ;; esac
    [ "$rref" = "refs/heads/$BASE" ] && continue
    [ "$_rsha" = "$ZERO" ] || continue
    if [ -n "${ALLOW_NEW_BASE:-}" ]; then echo "pre-push: creating '${rref#refs/heads/}' ALLOWED by ALLOW_NEW_BASE: $ALLOW_NEW_BASE" >&2; continue; fi
    echo "pre-push: REFUSED — this creates '${rref#refs/heads/}' on $REMOTE, whose base is '$BASE'. That is almost always" >&2
    echo "  a push from the wrong checkout. Check: git -C <abs-path> remote -v. Deliberate: ALLOW_NEW_BASE=\"<why>\" git push …" >&2
    exit 1
done <<< "$INPUT"
while read -r _lref _lsha rref _rsha; do
    [ "$rref" = "refs/heads/$BASE" ] || continue
    if [ -n "${ALLOW_BASE_PUSH:-}" ]; then
        LOG="$(git rev-parse --show-toplevel)/.claude/land-overrides.log"; mkdir -p "$(dirname "$LOG")"
        printf '%s\tdirect-base-push\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$BASE" "$_lsha" "$ALLOW_BASE_PUSH" >> "$LOG"
        echo "pre-push: direct push to '$BASE' ALLOWED by ALLOW_BASE_PUSH (logged): $ALLOW_BASE_PUSH" >&2
        exit 0
    fi
    echo "pre-push: REFUSED — this pushes straight to '$BASE', skipping the landing checks." >&2
    echo "  Land a sprint with /sprint-accept (scripts/agentic/land-lane.sh): it checks the lane contains" >&2
    echo "  $BASE, waits for CI, tags the sprint, deletes the branch and reaps the worktree." >&2
    echo "  Deliberate exception (logged): ALLOW_BASE_PUSH=\"<why>\" git push …" >&2
    exit 1
done <<< "$INPUT"
exit 0
