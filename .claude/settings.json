{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },
  "skillListingBudgetFraction": 0.02,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/agentic/preflight.sh"
          }
        ]
      }
    ]
  }
}